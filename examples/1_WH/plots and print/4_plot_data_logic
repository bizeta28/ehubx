# ======================================================
# FUNCTION: Daily LT-MT-HT Combined Plot with Dates
# ======================================================

output_folder_daily = os.path.join("examples", case_folder, "plots and print", "plots", "daily plots")

def plot_combined_daily(day):

    # ---------------------------
    # Define hourly slice
    # ---------------------------
    start_hour = (day - 1) * 24
    end_hour = day * 24

    time_index_full = pd.date_range(start='2023-01-01', periods=8760, freq='h')
    time_index_day = time_index_full[start_hour:end_hour]

    # ---------------------------
    # Get actual calendar date for title and filename
    # ---------------------------
    date_string = time_index_day[0].strftime('%d %B')        # e.g., "01 January"
    file_date_string = time_index_day[0].strftime('%m-%d')   # e.g., "01-01"

    # ---------------------------
    # Slice LT
    # ---------------------------
    LT_HE_AW = logicLT_df['HE_AW Serving Demand'].iloc[start_hour:end_hour]
    LT_Chiller = logicLT_df['Chiller Serving Demand'].iloc[start_hour:end_hour]
    LT_Storage = logicLT_df['Storage Discharge'].iloc[start_hour:end_hour]
    LT_Demand = valuesLT_df['Demand'].iloc[start_hour:end_hour]

    # ---------------------------
    # Slice MT
    # ---------------------------
    MT_HE_WW = logicMT_df['HE_WW Serving Demand'].iloc[start_hour:end_hour]
    MT_HP_AW = logicMT_df['HP_AW Serving Demand'].iloc[start_hour:end_hour]
    MT_Storage = logicMT_df['Storage Discharge'].iloc[start_hour:end_hour]
    MT_Demand = valuesMT_df['Demand'].iloc[start_hour:end_hour]

    # ---------------------------
    # Slice HT
    # ---------------------------
    HT_CS = logicHT_df['CS_hybrid Serving Demand'].iloc[start_hour:end_hour]
    HT_Import = logicHT_df['Import Serving Demand'].iloc[start_hour:end_hour]
    HT_HP_WW = logicHT_df['HP_WW Supply'].iloc[start_hour:end_hour]
    HT_Storage = logicHT_df['Plotted Storage Discharge'].iloc[start_hour:end_hour]
    HT_Demand = valuesHT_df['Demand'].iloc[start_hour:end_hour]

    # ---------------------------
    # Determine common y-limit
    # ---------------------------
    LT_total = LT_HE_AW + LT_Chiller + LT_Storage
    MT_total = MT_HE_WW + MT_HP_AW + MT_Storage
    HT_total = HT_CS + HT_Import + HT_Storage + HT_HP_WW

    max_val = max(LT_total.max(), MT_total.max(), HT_total.max()) * 1.05

    # ---------------------------
    # Create figure
    # ---------------------------
    fig, axes = plt.subplots(3, 1, figsize=(14, 10), sharex=True)

    # ======================================================
    # LT
    # ======================================================
    axes[0].stackplot(
        time_index_day,
        LT_HE_AW,
        LT_Chiller,
        LT_Storage,
        labels=['HE_AW', 'Chiller', 'Storage Discharge'],
        colors=['#1f77b4', '#ff7f0e', '#2ca02c']
    )
    axes[0].plot(time_index_day, LT_Demand, color='black', linewidth=1.2, label='Demand')
    # axes[0].set_title(f'{date_string}')
    axes[0].set_ylabel('Energy (kWh)', fontsize=12)
    axes[0].set_ylim(0, max_val)
    axes[0].legend(loc='upper right', fontsize=10)
    axes[0].grid(True, alpha=0.3)

    # ======================================================
    # MT
    # ======================================================
    axes[1].stackplot(
        time_index_day,
        MT_HE_WW,
        MT_HP_AW,
        MT_Storage,
        labels=['HE_WW', 'HP_AW', 'Storage Discharge'],
        colors=['#1f77b4', '#ff7f0e', '#2ca02c']
    )
    axes[1].plot(time_index_day, MT_Demand, color='black', linewidth=1.2, label='Demand')
    # axes[1].set_title(f'Medium Temperature (MT) – {date_string}')
    axes[1].set_ylabel('Energy (kWh)', fontsize=12)
    axes[1].set_ylim(0, max_val)
    axes[1].legend(loc='upper right', fontsize=10)
    axes[1].grid(True, alpha=0.3)

    # ======================================================
    # HT
    # ======================================================
    axes[2].stackplot(
        time_index_day,
        HT_CS,
        HT_Import,
        HT_HP_WW,
        HT_Storage,
        labels=['CS_hybrid', 'Import', 'HP_WW', 'Storage Discharge'],
        colors=['#1f77b4', '#ff7f0e', '#d62728', '#2ca02c']
    )
    axes[2].plot(time_index_day, HT_Demand, color='black', linewidth=1.2, label='Demand')
    # axes[2].set_title(f'High Temperature (HT) – {date_string}')
    axes[2].set_ylabel('Energy (kWh)', fontsize=12)
    axes[2].set_xlabel('Hour of Day', fontsize=12)
    axes[2].set_ylim(0, max_val)
    axes[2].legend(loc='upper right', fontsize=10)
    axes[2].grid(True, alpha=0.3)

    plt.tight_layout()

    daily_plot_path = os.path.join(output_folder_daily, f'combined_LT_MT_HT_{file_date_string}.png')
    plt.savefig(daily_plot_path, dpi=300)
    plt.close()

    print(f"Combined LT-MT-HT plot for {date_string} saved to:", daily_plot_path)


